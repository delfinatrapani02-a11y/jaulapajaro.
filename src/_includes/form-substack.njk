{%- from "trazos.njk" import subrayado -%}
{#- Suscripción directa a Substack: abre la confirmación de Substack en otra pestaña -#}
<form class="form-nl" action="{{ sitio.substack }}/api/v1/free?nojs=true" method="post" target="_blank" aria-label="sumarse al newsletter">
  <label>
    <span class="chico" style="font-size: 12px">tu mail</span>
    <input type="email" name="email" required autocomplete="email">
  </label>
  <button class="boton-claro" type="submit">{{ subrayado("sumarme →") }}</button>
</form>
